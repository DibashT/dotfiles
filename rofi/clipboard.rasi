/* Clipboard - heading only, no search - based on keyhint.rasi */
configuration {
  show-icons: false;
}

* {
  font: "JetBrains Mono Nerd Font 10";
  background:     #1F1F28;
  background-alt: #2A2A37;
  foreground:     #DCD7BA;
  active:         #7E9CD8;
  selected:       #2D4F67;
  urgent:         #E82424;
}

window {
  transparency: "real";
  location: center;
  anchor: center;
  fullscreen: false;
  width: 620px;
  x-offset: 0px;
  y-offset: 0px;
  enabled: true;
  border-radius: 14px;
  border: 2px;
  border-color: @active;
  cursor: "default";
  background-color: @background;
}

mainbox {
  enabled: true;
  spacing: 8px;
  padding: 16px;
  background-color: transparent;
  orientation: vertical;
  children: [ "message", "listview" ];
}

message {
  enabled: true;
  padding: 12px;
  margin: 0px 0px 4px 0px;
  border-radius: 10px;
  border: 1px;
  border-color: @active;
  background-color: @background-alt;
  text-color: @foreground;
}

textbox {
  enabled: true;
  background-color: transparent;
  text-color: @foreground;
  vertical-align: 0.5;
  horizontal-align: 0.5;
  font: "JetBrains Mono Nerd Font Bold 11";
}

listview {
  enabled: true;
  columns: 1;
  lines: 10;
  cycle: true;
  dynamic: false;
  scrollbar: false;
  layout: vertical;
  reverse: false;
  fixed-height: true;
  fixed-columns: true;
  spacing: 4px;
  padding: 4px 0px 0px 0px;
  background-color: transparent;
  text-color: @foreground;
  cursor: "default";
}

element {
  enabled: true;
  spacing: 10px;
  padding: 6px;
  border-radius: 10px;
  background-color: transparent;
  text-color: @foreground;
  cursor: pointer;
}

element normal.normal {
  background-color: transparent;
  text-color: @foreground;
}

element alternate.normal {
  background-color: transparent;
  text-color: @foreground;
}

element selected.normal {
  background-color: @selected;
  text-color: @foreground;
}

element-text {
  background-color: transparent;
  text-color: inherit;
  cursor: inherit;
  vertical-align: 0.5;
  horizontal-align: 0.0;
}
