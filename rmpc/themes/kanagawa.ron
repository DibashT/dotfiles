#![enable(implicit_some)]
#![enable(unwrap_newtypes)]
#![enable(unwrap_variant_newtypes)]

(
default_album_art_path: None,
format_tag_separator: " | ",
browser_column_widths: [20, 38, 42],

```
// ============================================================
// KANAGAWA COLORS
// ============================================================

background_color: "#16161D",
text_color: "#DCD7BA",
header_background_color: "#16161D",
modal_background_color: "#16161D",
modal_backdrop: false,

preview_label_style: (
    fg: "#E6C384"
),

preview_metadata_group_style: (
    fg: "#E6C384",
    modifiers: "Bold"
),

highlighted_item_style: (
    fg: "#7E9CD8",
    modifiers: "Bold"
),

current_item_style: (
    fg: "#16161D",
    bg: "#7E9CD8",
    modifiers: "Bold"
),

borders_style: (
    fg: "#54546D"
),

highlight_border_style: (
    fg: "#7E9CD8"
),

// ============================================================
// SYMBOLS
// ============================================================

symbols: (
    song: "S",
    dir: "D",
    playlist: "P",
    marker: "M",
    ellipsis: "...",

    song_style: None,
    dir_style: None,
    playlist_style: None,
    marker_style: None,

    song_highlighted_style: None,
    dir_highlighted_style: None,
    playlist_highlighted_style: None,
    marker_highlighted_style: None,

    song_current_style: None,
    dir_current_style: None,
    playlist_current_style: None,
    marker_current_style: None,
),

// ============================================================
// LOG LEVEL COLORS
// ============================================================

level_styles: (
    info: (
        fg: "#7E9CD8",
        bg: "#16161D"
    ),

    warn: (
        fg: "#E6C384",
        bg: "#16161D"
    ),

    error: (
        fg: "#E46876",
        bg: "#16161D"
    ),

    debug: (
        fg: "#98BB6C",
        bg: "#16161D"
    ),

    trace: (
        fg: "#957FB8",
        bg: "#16161D"
    ),
),

// ============================================================
// PROGRESS BAR
// ============================================================

progress_bar: (
    symbols: ["█", "█", "█", " ", "█"],

    track_style: None,

    elapsed_style: (
        fg: "#7E9CD8"
    ),

    thumb_style: (
        fg: "#E6C384"
    ),

    use_track_when_empty: true,
),

// ============================================================
// SCROLLBAR
// ============================================================

scrollbar: (
    symbols: ["│", "█", "▲", "▼"],

    track_style: (),

    ends_style: (),

    thumb_style: (
        fg: "#7E9CD8"
    ),
),

// ============================================================
// TAB BAR
// ============================================================

tab_bar: (
    active_style: (
        fg: "#16161D",
        bg: "#7E9CD8",
        modifiers: "Bold"
    ),

    inactive_style: (
        fg: "#C8C093"
    ),
),

// ============================================================
// LYRICS
// ============================================================

lyrics: (
    timestamp: false
),

// ============================================================
// BROWSER
// ============================================================

browser_song_format: [
    (
        kind: Group([
            (kind: Property(Track)),
            (kind: Text(" ")),
        ])
    ),

    (
        kind: Group([
            (kind: Property(Artist)),
            (kind: Text(" - ")),
            (kind: Property(Title)),
        ]),

        default: (
            kind: Property(Filename)
        )
    ),
],

// ============================================================
// QUEUE COLUMNS
//
// Title -> Artist -> Duration
// Album removed
// ============================================================

song_table_format: [
    (
        prop: (
            kind: Property(
                Title,
                default: (kind: Text("Unknown"))
            )
        ),

        label_prop: (
            kind: Text("Title")
        ),

        width: "55%",
    ),

    (
        prop: (
            kind: Property(
                Artist,
                default: (kind: Text("Unknown"))
            )
        ),

        label_prop: (
            kind: Text("Artist")
        ),

        width: "30%",
    ),

    (
        prop: (
            kind: Property(
                Duration,
                default: (kind: Text("-"))
            )
        ),

        label_prop: (
            kind: Text("Duration")
        ),

        width: "15%",

        alignment: Right,
    ),
],

// ============================================================
// MAIN LAYOUT
// ============================================================

layout: Split(
    direction: Vertical,

    panes: [

        // ----------------------------------------------------
        // TOP HEADER
        // ----------------------------------------------------

        (
            size: "4",

            pane: Split(
                direction: Horizontal,

                panes: [

                    (
                        size: "35",

                        borders: "LEFT | TOP | BOTTOM",

                        border_symbols: Inherited(
                            parent: Rounded,
                            bottom_left: "├"
                        ),

                        pane: Component("header_left")
                    ),

                    (
                        size: "100%",

                        borders: "ALL",

                        border_symbols: Inherited(
                            parent: Rounded,
                            top_left: "┬",
                            top_right: "┬",
                            bottom_left: "┴",
                            bottom_right: "┴"
                        ),

                        pane: Component("header_center")
                    ),

                    (
                        size: "35",

                        borders: "RIGHT | TOP | BOTTOM",

                        border_symbols: Inherited(
                            parent: Rounded,
                            bottom_right: "┤"
                        ),

                        pane: Component("header_right")
                    ),
                ]
            )
        ),

        // ----------------------------------------------------
        // TABS
        // ----------------------------------------------------

        (
            pane: Pane(Tabs),

            borders: "RIGHT | LEFT | BOTTOM",

            border_symbols: Rounded,

            size: "2",
        ),

        // ----------------------------------------------------
        // TAB CONTENT
        // ----------------------------------------------------

        (
            pane: Pane(TabContent),

            size: "100%",
        ),

        // ----------------------------------------------------
        // BOTTOM BAR
        // ----------------------------------------------------

        (
            size: "3",

            pane: Split(
                direction: Horizontal,

                panes: [

                    (
                        size: "12",

                        borders: "ALL",

                        border_symbols: Inherited(
                            parent: Rounded,
                            top_right: "┬",
                            bottom_right: "┴"
                        ),

                        pane: Component("input_mode")
                    ),

                    (
                        size: "100%",

                        borders: "TOP | BOTTOM | RIGHT",

                        border_symbols: Rounded,

                        border_title: [
                            (kind: Text(" ")),
                            (
                                kind: Property(
                                    Status(QueueLength())
                                )
                            ),
                            (kind: Text(" songs / ")),
                            (
                                kind: Property(
                                    Status(QueueTimeTotal())
                                )
                            ),
                            (kind: Text(" total time "))
                        ],

                        border_title_alignment: Right,

                        pane: Component("progress_bar"),
                    ),
                ]
            ),
        ),
    ],
),

// ============================================================
// COMPONENTS
// ============================================================

components: {

    // --------------------------------------------------------
    // STATE
    // --------------------------------------------------------

    "state": Pane(Property(
        content: [

            (
                kind: Text("["),
                style: (
                    fg: "#E6C384",
                    modifiers: "Bold"
                )
            ),

            (
                kind: Property(
                    Status(StateV2())
                ),

                style: (
                    fg: "#E6C384",
                    modifiers: "Bold"
                )
            ),

            (
                kind: Text("]"),
                style: (
                    fg: "#E6C384",
                    modifiers: "Bold"
                )
            ),
        ],

        align: Left,
    )),

    // --------------------------------------------------------
    // CURRENT SONG TITLE
    // --------------------------------------------------------

    "title": Pane(Property(
        content: [

            (
                kind: Property(
                    Song(Title)
                ),

                style: (
                    modifiers: "Bold"
                ),

                default: (
                    kind: Text("No Song"),
                    style: (
                        modifiers: "Bold"
                    )
                )
            ),
        ],

        align: Center,

        scroll_speed: 1
    )),

    // --------------------------------------------------------
    // VOLUME
    // --------------------------------------------------------

    "volume": Split(
        direction: Horizontal,

        panes: [

            (
                size: "1",

                pane: Pane(
                    Property(
                        content: [
                            (kind: Text(""))
                        ]
                    )
                )
            ),

            (
                size: "100%",

                pane: Pane(
                    Volume(
                        kind: Slider(
                            symbols: (
                                start: None,
                                filled: "─",
                                thumb: "●",
                                track: "─",
                                end: None
                            )
                        )
                    )
                )
            ),

            (
                size: "3",

                pane: Pane(
                    Property(
                        content: [
                            (
                                kind: Property(
                                    Status(Volume)
                                ),

                                style: (
                                    fg: "#7E9CD8"
                                )
                            )
                        ],

                        align: Right
                    )
                )
            ),

            (
                size: "2",

                pane: Pane(
                    Property(
                        content: [
                            (
                                kind: Text("%"),
                                style: (
                                    fg: "#7E9CD8"
                                )
                            )
                        ]
                    )
                )
            ),
        ]
    ),

    // --------------------------------------------------------
    // ELAPSED / BITRATE
    // --------------------------------------------------------

    "elapsed_and_bitrate": Pane(Property(
        content: [

            (
                kind: Property(
                    Status(Elapsed)
                )
            ),

            (
                kind: Text(" / ")
            ),

            (
                kind: Property(
                    Status(Duration)
                )
            ),

            (
                kind: Group([
                    (kind: Text(" (")),
                    (
                        kind: Property(
                            Status(Bitrate)
                        )
                    ),
                    (kind: Text(" kbps)")),
                ])
            ),
        ],

        align: Left,
    )),

    // --------------------------------------------------------
    // ARTIST
    // Album removed
    // --------------------------------------------------------

    "artist": Pane(Property(
        content: [

            (
                kind: Property(
                    Song(Artist)
                ),

                style: (
                    fg: "#E6C384",
                    modifiers: "Bold"
                ),

                default: (
                    kind: Text("Unknown"),
                    style: (
                        fg: "#E6C384",
                        modifiers: "Bold"
                    )
                )
            ),
        ],

        align: Center,

        scroll_speed: 1
    )),

    // --------------------------------------------------------
    // STATES
    // --------------------------------------------------------

    "states": Split(
        direction: Horizontal,

        panes: [

            (
                size: "1",

                pane: Pane(Empty())
            ),

            (
                size: "100%",

                pane: Pane(
                    Property(
                        content: [

                            (
                                kind: Property(
                                    Status(InputBuffer())
                                ),

                                style: (
                                    fg: "#7E9CD8"
                                ),

                                align: Left
                            )
                        ]
                    )
                )
            ),

            (
                size: "6",

                pane: Pane(
                    Property(
                        content: [

                            (
                                kind: Text("["),
                                style: (
                                    fg: "#7E9CD8",
                                    modifiers: "Bold"
                                )
                            ),

                            (
                                kind: Property(
                                    Status(
                                        RepeatV2(
                                            on_label: "z",
                                            off_label: "z",

                                            on_style: (
                                                fg: "#E6C384",
                                                modifiers: "Bold"
                                            ),

                                            off_style: (
                                                fg: "#7E9CD8",
                                                modifiers: "Dim"
                                            ),
                                        )
                                    )
                                )
                            ),

                            (
                                kind: Property(
                                    Status(
                                        RandomV2(
                                            on_label: "x",
                                            off_label: "x",

                                            on_style: (
                                                fg: "#E6C384",
                                                modifiers: "Bold"
                                            ),

                                            off_style: (
                                                fg: "#7E9CD8",
                                                modifiers: "Dim"
                                            ),
                                        )
                                    )
                                )
                            ),

                            (
                                kind: Property(
                                    Status(
                                        ConsumeV2(
                                            on_label: "c",
                                            off_label: "c",
                                            oneshot_label: "c",

                                            on_style: (
                                                fg: "#E6C384",
                                                modifiers: "Bold"
                                            ),

                                            off_style: (
                                                fg: "#7E9CD8",
                                                modifiers: "Dim"
                                            ),

                                            oneshot_style: (
                                                fg: "#E46876",
                                                modifiers: "Dim"
                                            ),
                                        )
                                    )
                                )
                            ),

                            (
                                kind: Property(
                                    Status(
                                        SingleV2(
                                            on_label: "v",
                                            off_label: "v",
                                            oneshot_label: "v",

                                            on_style: (
                                                fg: "#E6C384",
                                                modifiers: "Bold"
                                            ),

                                            off_style: (
                                                fg: "#7E9CD8",
                                                modifiers: "Dim"
                                            ),

                                            oneshot_style: (
                                                fg: "#E46876",
                                                modifiers: "Bold"
                                            ),
                                        )
                                    )
                                )
                            ),

                            (
                                kind: Text("]"),
                                style: (
                                    fg: "#7E9CD8",
                                    modifiers: "Bold"
                                )
                            ),
                        ],

                        align: Right
                    )
                )
            ),
        ]
    ),

    // --------------------------------------------------------
    // INPUT MODE
    // --------------------------------------------------------

    "input_mode": Pane(Property(
        content: [

            (
                kind: Transform(
                    Replace(
                        content: (
                            kind: Property(
                                Status(InputMode())
                            )
                        ),

                        replacements: [

                            (
                                match: "Normal",

                                replace: (
                                    kind: Text(" NORMAL "),

                                    style: (
                                        fg: "#16161D",
                                        bg: "#7E9CD8"
                                    )
                                )
                            ),

                            (
                                match: "Insert",

                                replace: (
                                    kind: Text(" INSERT "),

                                    style: (
                                        fg: "#16161D",
                                        bg: "#98BB6C"
                                    )
                                )
                            ),
                        ]
                    )
                )
            )
        ],

        align: Center
    )),

    // --------------------------------------------------------
    // HEADER LEFT
    // --------------------------------------------------------

    "header_left": Split(
        direction: Vertical,

        panes: [

            (
                size: "1",

                pane: Component("state")
            ),

            (
                size: "1",

                pane: Component("elapsed_and_bitrate")
            ),
        ]
    ),

    // --------------------------------------------------------
    // HEADER CENTER
    //
    // Title
    // Artist
    // --------------------------------------------------------

    "header_center": Split(
        direction: Vertical,

        panes: [

            (
                size: "1",

                pane: Component("title")
            ),

            (
                size: "1",

                pane: Component("artist")
            ),
        ]
    ),

    // --------------------------------------------------------
    // HEADER RIGHT
    // --------------------------------------------------------

    "header_right": Split(
        direction: Vertical,

        panes: [

            (
                size: "1",

                pane: Component("volume")
            ),

            (
                size: "1",

                pane: Component("states")
            ),
        ]
    ),

    // --------------------------------------------------------
    // PROGRESS BAR
    // --------------------------------------------------------

    "progress_bar": Split(
        direction: Horizontal,

        panes: [

            (
                size: "1",

                pane: Pane(Empty())
            ),

            (
                size: "100%",

                pane: Pane(ProgressBar)
            ),

            (
                size: "1",

                pane: Pane(Empty())
            ),
        ]
    ),
},
```

)
