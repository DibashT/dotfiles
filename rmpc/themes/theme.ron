#![enable(implicit_some)]
#![enable(unwrap_newtypes)]
#![enable(unwrap_variant_newtypes)]
(
    default_album_art_path: None,
    format_tag_separator: " • ",
    browser_column_widths: [20, 38, 42],
    background_color: None,
    text_color: "#e0def4",
    header_background_color: None,
    modal_background_color: None,
    modal_backdrop: true,
    preview_label_style: (fg: "#f6c177", modifiers: "Bold"),
    preview_metadata_group_style: (fg: "#f6c177", modifiers: "Bold | Underlined"),
    highlighted_item_style: (fg: "#7fb4ca", modifiers: "Bold"),
    current_item_style: (fg: "#191724", bg: "#7fb4ca", modifiers: "Bold"),
    borders_style: (fg: "#6e6a86"),
    highlight_border_style: (fg: "#7fb4ca", modifiers: "Bold"),
    symbols: (
        song: "",
        dir: "",
        playlist: "",
        marker: "▸",
        ellipsis: "…",
        song_style: (fg: "#c4a7e7"),
        dir_style: (fg: "#f6c177"),
        playlist_style: (fg: "#7fb4ca"),
        marker_style: (fg: "#ebbcba", modifiers: "Bold"),
        song_highlighted_style: (fg: "#c4a7e7", modifiers: "Bold"),
        dir_highlighted_style: (fg: "#f6c177", modifiers: "Bold"),
        playlist_highlighted_style: (fg: "#7fb4ca", modifiers: "Bold"),
        marker_highlighted_style: None,
        song_current_style: None,
        dir_current_style: None,
        playlist_current_style: None,
        marker_current_style: None,
    ),
    level_styles: (
        info: (fg: "#7fb4ca"),
        warn: (fg: "#f6c177"),
        error: (fg: "#eb6f92", modifiers: "Bold"),
        debug: (fg: "#31748f"),
        trace: (fg: "#6e6a86"),
    ),
    progress_bar: (
        symbols: ["▓", "▓", "▒", " ", "░"],
        track_style: (fg: "#26233a"),
        elapsed_style: (fg: "#7fb4ca", modifiers: "Bold"),
        thumb_style: (fg: "#ebbcba"),
        use_track_when_empty: true,
    ),
    scrollbar: (
        symbols: ["│", "", "", ""],
        track_style: (),
        ends_style: (),
        thumb_style: (fg: "#7fb4ca"),
    ),
    tab_bar: (
        active_style: (fg: "#191724", bg: "#7fb4ca", modifiers: "Bold"),
        inactive_style: (fg: "#908caa"),
    ),
    lyrics: (
        timestamp: false
    ),
    cava: (
        bar_symbols: ['▁', '▂', '▃', '▄', '▅', '▆', '▇', '█'],
        bar_width: 2,
        bar_spacing: 1,
        orientation: Bottom,
        // Rose Pine x Kanagawa party mix: green -> blue -> violet -> pink -> gold -> red
        bar_color: Gradient({
            0: "#98bb6c",
            20: "#7fb4ca",
            35: "#7e9cd8",
            50: "#957fb8",
            65: "#c4a7e7",
            80: "#ebbcba",
            90: "#f6c177",
            100: "#eb6f92",
        }),
    ),
    browser_song_format: [
        (
            kind: Group([
                (kind: Property(Track)),
                (kind: Text(" ")),
            ])
        ),
        (
            kind: Group([
                (kind: Property(Artist)),
                (kind: Text(" ‣ ")),
                (kind: Property(Title)),
            ]),
            default: (kind: Property(Filename))
        ),
    ],
    song_table_format: [
        (
            prop: (
                kind: Property(Title),
                default: (
                    kind: Text("Unknown")
                )
            ),
            style: (fg: "#7fb4ca", modifiers: "Bold"),
            label_prop: (
                kind: Text("Title")
            ),
            width: "55%",
        ),
        (
            prop: (
                kind: Property(Artist),
                default: (
                    kind: Text("Unknown")
                )
            ),
            style: (fg: "#ebbcba"),
            label_prop: (
                kind: Text("Artist")
            ),
            width: "30%",
        ),
        (
            prop: (
                kind: Property(Duration),
                default: (
                    kind: Text("-")
                )
            ),
            style: (fg: "#c4a7e7"),
            label_prop: (
                kind: Text("Duration")
            ),
            width: "15%",
            alignment: Right,
        ),
    ],
    layout: Split(
        direction: Vertical,
        panes: [
            (
                size: "4",
                pane: Split(
                    direction: Horizontal,
                    panes: [
                        (
                            size: "35",
                            borders: "LEFT | TOP | BOTTOM",
                            border_symbols: Inherited(parent: Thick, bottom_left: "┣"),
                            pane: Component("header_left")
                        ),
                        (
                            size: "100%",
                            borders: "ALL",
                            border_symbols: Inherited(parent: Thick, top_left: "┳", top_right: "┳", bottom_left: "┻", bottom_right: "┻"),
                            pane: Component("header_center")
                        ),
                        (
                            size: "35",
                            borders: "RIGHT | TOP | BOTTOM",
                            border_symbols: Inherited(parent: Thick, bottom_right: "┫"),
                            pane: Component("header_right")
                        ),
                    ]
                )
            ),
            (
                pane: Pane(Tabs),
                borders: "RIGHT | LEFT | BOTTOM",
                border_symbols: Thick,
                size: "2",
            ),
            (
                pane: Pane(TabContent),
                size: "100%",
            ),
            (
                size: "3",
                pane: Split(
                    direction: Horizontal,
                    panes: [
                        (
                            size: "12",
                            borders: "ALL",
                            border_symbols: Inherited(parent: Thick, top_right: "┳", bottom_right: "┻"),
                            pane: Component("input_mode")
                        ),
                        (
                            size: "100%",
                            borders: "TOP | BOTTOM | RIGHT",
                            border_symbols: Thick,
                            border_title: [(kind: Text(" ")), (kind: Property(Status(QueueLength()))), (kind: Text(" songs / ")), (kind: Property(Status(QueueTimeTotal()))), (kind: Text(" total time "))],
                            border_title_alignment: Right,
                            pane: Component("progress_bar"),
                        ),
                    ]
                ),
            ),
        ],
    ),
    components: {
        "state": Pane(Property(
            content: [
                (kind: Text("["), style: (fg: "#f6c177", modifiers: "Bold")),
                (kind: Property(Status(StateV2( ))), style: (fg: "#f6c177", modifiers: "Bold")),
                (kind: Text("]"), style: (fg: "#f6c177", modifiers: "Bold")),
            ], align: Left,
        )),
        "title": Pane(Property(
            content: [
                (kind: Property(Song(Title)), style: (fg: "#e0def4", modifiers: "Bold"),
                    default: (kind: Text("No Song"), style: (fg: "#6e6a86", modifiers: "Dim"))),
            ], align: Center, scroll_speed: 1
        )),
        "volume": Split(
            direction: Horizontal,
            panes: [
                (size: "2", pane: Pane(Property(content: [(kind: Text(" "))]))),
                (size: "100%", pane: Pane(Volume(kind: Slider(symbols: (start: None, filled: "━", thumb: "●", track: "─", end: None))))),
                (size: "3", pane: Pane(Property(content: [(kind: Property(Status(Volume)), style: (fg: "#7fb4ca", modifiers: "Bold"))], align: Right))),
                (size: "2", pane: Pane(Property(content: [(kind: Text("%"), style: (fg: "#7fb4ca"))]))),
            ]
        ),
        "elapsed_and_bitrate": Pane(Property(
            content: [
                (kind: Property(Status(Elapsed)), style: (fg: "#7fb4ca")),
                (kind: Text(" / "), style: (fg: "#6e6a86")),
                (kind: Property(Status(Duration)), style: (fg: "#7fb4ca")),
                (kind: Group([
                    (kind: Text(" ["), style: (fg: "#6e6a86")),
                    (kind: Property(Status(Bitrate)), style: (fg: "#f6c177")),
                    (kind: Text(" kbps]"), style: (fg: "#6e6a86")),
                ])),
            ],
            align: Left,
        )),
        "artist": Pane(Property(
            content: [
                (
                    kind: Property(Song(Artist)),
                    style: (fg: "#ebbcba", modifiers: "Bold"),
                    default: (
                        kind: Text("Unknown"),
                        style: (fg: "#6e6a86", modifiers: "Dim")
                    )
                ),
            ],
            align: Center,
            scroll_speed: 1
        )),
        "states": Split(
            direction: Horizontal,
            panes: [
                (
                    size: "1",
                    pane: Pane(Empty())
                ),
                (
                    size: "100%",
                    pane: Pane(Property(content: [(kind: Property(Status(InputBuffer())), style: (fg: "#7fb4ca"), align: Left)]))
                ),
                (
                    size: "6",
                    pane: Pane(Property(content: [
                        (kind: Text("["), style: (fg: "#7fb4ca", modifiers: "Bold")),
                        (kind: Property(Status(RepeatV2(
                            on_label: "z",
                            off_label: "z",
                            on_style: (fg: "#f6c177", modifiers: "Bold"),
                            off_style: (fg: "#6e6a86", modifiers: "Dim"),
                        )))),
                        (kind: Property(Status(RandomV2(
                            on_label: "x",
                            off_label: "x",
                            on_style: (fg: "#f6c177", modifiers: "Bold"),
                            off_style: (fg: "#6e6a86", modifiers: "Dim"),
                        )))),
                        (kind: Property(Status(ConsumeV2(
                            on_label: "c",
                            off_label: "c",
                            oneshot_label: "c",
                            on_style: (fg: "#f6c177", modifiers: "Bold"),
                            off_style: (fg: "#6e6a86", modifiers: "Dim"),
                            oneshot_style: (fg: "#eb6f92", modifiers: "Dim"),
                        )))),
                        (kind: Property(Status(SingleV2(
                            on_label: "v",
                            off_label: "v",
                            oneshot_label: "v",
                            on_style: (fg: "#f6c177", modifiers: "Bold"),
                            off_style: (fg: "#6e6a86", modifiers: "Dim"),
                            oneshot_style: (fg: "#eb6f92", modifiers: "Bold"),
                        )))),
                        (kind: Text("]"), style: (fg: "#7fb4ca", modifiers: "Bold")),
                        ],
                        align: Right
                    ))
                ),
            ]
        ),
        "input_mode": Pane(Property(
            content: [
                (kind: Transform(Replace(content: (kind: Property(Status(InputMode()))), replacements: [
                (match: "Normal", replace: (kind: Text(" NORMAL "), style: (fg: "#191724", bg: "#7fb4ca", modifiers: "Bold"))),
                (match: "Insert", replace: (kind: Text(" INSERT "), style: (fg: "#191724", bg: "#31748f", modifiers: "Bold"))),
                ])))
            ], align: Center
        )),
        "header_left": Split(
            direction: Vertical,
            panes: [
                (size: "1", pane: Component("state")),
                (size: "1", pane: Component("elapsed_and_bitrate")),
            ]
        ),
        "header_center": Split(
            direction: Vertical,
            panes: [
                (size: "1", pane: Component("title")),
                (size: "1", pane: Component("artist")),
            ]
        ),
        "header_right": Split(
            direction: Vertical,
            panes: [
                (size: "1", pane: Component("volume")),
                (size: "1", pane: Component("states")),
            ]
        ),
        "progress_bar": Split(
            direction: Horizontal,
            panes: [
                (
                    size: "1",
                    pane: Pane(Empty())
                ),
                (
                    size: "100%",
                    pane: Pane(ProgressBar)
                ),
                (
                    size: "1",
                    pane: Pane(Empty())
                ),
            ]
        )
    },
)
